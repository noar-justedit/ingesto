docs/notes/harness/out/

# macOS clutter. "Icon?" is the hidden custom-icon file (Icon + carriage
# return). Not "Icon*": with macOS ignoring case, it would also hide
# build-resources/icon.icns.
.DS_Store
Icon?

# Never in the repository: signing certificates and delivery archives
*.p12
*.zip
