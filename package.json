{
  "name": "ingesto",
  "version": "2.6.1",
  "engines": {
    "node": ">=20.19"
  },
  "description": "Professional camera media ingest application",
  "main": "src/main/main.js",
  "author": "Just Edit <contact@just-edit.fr>",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/noar-justedit/ingesto.git"
  },
  "homepage": "https://github.com/noar-justedit/ingesto",
  "bugs": {
    "url": "https://github.com/noar-justedit/ingesto/issues"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "test": "node scripts/test-p0.js && node scripts/test-parallel-verify.js && node scripts/test-ascmhl.js && node scripts/test-volume-check.js && node scripts/test-folders.js && node scripts/test-verify.js && node scripts/test-safety.js && node scripts/test-win-volumes.js",
    "build": "electron-builder --config electron-builder.yml --mac --arm64",
    "build:dmg": "electron-builder --mac dmg",
    "pack": "electron-builder --dir",
    "build:universal": "electron-builder --config electron-builder.yml --mac --universal",
    "build:win": "electron-builder --config electron-builder.yml --win --x64",
    "build:all": "electron-builder --config electron-builder.yml --mac --arm64 && electron-builder --config electron-builder.yml --win --x64",
    "build:linux": "electron-builder --config electron-builder.yml --linux"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0"
  },
  "optionalDependencies": {
    "koffi": "^2.10.0"
  }
}
